/*
 * Flying Rush HUD: cyan and amber on the cage's dusky violet. Exo 2 Black is the display face,
 * Exo 2 SemiBold the text face. Laid out at 1280x720 reference pixels; the panel settings scale
 * it to the screen. Hud.cs builds the elements and gives them these classes.
 */

:root {
    --cyan: #38d9ff;
    --amber: #ffb238;
    --danger: #ff3b4f;
    --good: #5dffa8;
    --gold: #ffd84a;
    --neon: #a45cff;
    --text: #f6f0ff;
    --muted: #b8a8c8;
    --panel: rgba(20, 10, 28, 0.82);
    --panel-light: rgba(20, 10, 28, 0.55);

    color: var(--text);
    font-size: 18px;
    -unity-font-definition: url("ExoSemiBold.asset");
}

.display {
    -unity-font-definition: url("ExoBlack.asset");
}

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hidden {
    display: none;
}

.shadow {
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.6);
}

/* ---- Crosshair, hit marker, scope ---- */

.center {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    overflow: visible;
}

.cross-bar {
    position: absolute;
    background-color: rgba(246, 240, 255, 0.9);
}

.cross-dot {
    position: absolute;
    left: -2px;
    top: -2px;
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background-color: var(--cyan);
}

.hit-bar {
    position: absolute;
    width: 3px;
    height: 12px;
    background-color: white;
}

.hit--kill .hit-bar {
    background-color: var(--danger);
}

.hit--head .hit-bar {
    background-color: var(--gold);
}

.scope {
    position: absolute;
    left: -1000px;
    top: -1000px;
    width: 2000px;
    height: 2000px;
    border-radius: 1000px;
    border-width: 680px;
    border-color: rgb(6, 4, 10);
}

.scope-line {
    position: absolute;
    background-color: rgba(10, 10, 14, 0.85);
}

.vignette {
    background-image: url("Vignette.png");
    -unity-background-image-tint-color: rgb(255, 40, 60);
    opacity: 0;
}

.indicator {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    overflow: visible;
}

.indicator__arrow {
    position: absolute;
    left: -34px;
    top: -150px;
    width: 68px;
    height: 12px;
    border-radius: 6px;
    background-color: var(--danger);
}

.target-name {
    position: absolute;
    left: -200px;
    top: 34px;
    width: 400px;
    -unity-text-align: middle-center;
    font-size: 16px;
    color: var(--danger);
}

.marker {
    position: absolute;
    width: 12px;
    height: 12px;
    rotate: 45deg;
    background-color: var(--cyan);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.6);
}

/* ---- Top bar ---- */

.top-center {
    position: absolute;
    top: 10px;
    left: 340px;
    right: 340px;
    align-items: center;
}

.score-row {
    flex-direction: row;
    align-items: center;
}

.score-chip {
    min-width: 110px;
    height: 48px;
    padding: 0 14px;
    border-radius: 6px;
    background-color: var(--panel);
    align-items: center;
    justify-content: center;
}

.score-chip__label {
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--muted);
}

.score-chip__value {
    font-size: 26px;
    height: 28px;
    -unity-text-align: middle-center;
}

.timer {
    margin: 0 10px;
    width: 100px;
    height: 48px;
    font-size: 26px;
    -unity-text-align: middle-center;
    border-radius: 6px;
    background-color: var(--panel-light);
}

.limit {
    margin-top: 4px;
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.8);
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 2px;
}

.feed {
    position: absolute;
    top: 12px;
    right: 16px;
    width: 330px;
    align-items: flex-end;
}

.feed-line {
    flex-direction: row;
    padding: 3px 8px;
    margin-bottom: 3px;
    border-radius: 4px;
    background-color: var(--panel-light);
    font-size: 15px;
}

.feed-line--you {
    border-left-width: 3px;
    border-color: var(--gold);
}

.feed-weapon {
    color: var(--muted);
    margin: 0 6px;
}

.mode-tag {
    position: absolute;
    top: 14px;
    left: 18px;
    font-size: 13px;
    letter-spacing: 2px;
    color: var(--muted);
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.8);
}

.board-open .banner,
.board-open .banner-sub,
.board-open .kill-note {
    display: none;
}

/* ---- Bottom bars ---- */

.vitals {
    position: absolute;
    left: 24px;
    bottom: 22px;
    width: 300px;
}

.health-row {
    flex-direction: row;
    align-items: flex-end;
}

.health-value {
    font-size: 44px;
    height: 48px;
    width: 96px;
    -unity-text-align: lower-left;
}

.health-bar {
    flex-grow: 1;
    height: 12px;
    margin-bottom: 10px;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.45);
    overflow: hidden;
}

.health-bar__fill {
    height: 12px;
    width: 100%;
    background-color: var(--good);
}

.jumps {
    flex-direction: row;
    margin-top: 6px;
    align-items: center;
}

.jumps__label {
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--muted);
    margin-right: 8px;
}

.jump-pip {
    width: 22px;
    height: 8px;
    margin-right: 4px;
    border-radius: 2px;
    background-color: var(--cyan);
}

.jump-pip--used {
    background-color: rgba(255, 255, 255, 0.15);
}

.weapon {
    position: absolute;
    right: 24px;
    bottom: 22px;
    width: 320px;
    align-items: flex-end;
}

.weapon-name {
    font-size: 16px;
    letter-spacing: 2px;
}

.ammo {
    font-size: 44px;
    height: 48px;
    -unity-text-align: lower-right;
}

.ammo--low {
    color: var(--danger);
}

.reload-bar {
    width: 180px;
    height: 6px;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.45);
    overflow: hidden;
}

.reload-bar__fill {
    height: 6px;
    width: 0;
    background-color: var(--amber);
}

.weapon-alt {
    margin-top: 4px;
    font-size: 13px;
    color: var(--muted);
}

/* ---- Banners ---- */

.banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 150px;
    -unity-text-align: middle-center;
    font-size: 56px;
    color: var(--gold);
    transition-property: scale, opacity;
    transition-duration: 0.15s;
}

.banner--pop {
    scale: 1.2 1.2;
}

.banner-sub {
    position: absolute;
    left: 0;
    right: 0;
    top: 222px;
    -unity-text-align: middle-center;
    font-size: 20px;
}

.notice {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 132px;
    -unity-text-align: middle-center;
    font-size: 18px;
    color: var(--amber);
}

.kill-note {
    position: absolute;
    left: 0;
    right: 0;
    top: 410px;
    -unity-text-align: middle-center;
    font-size: 18px;
}

.respawn {
    position: absolute;
    left: 390px;
    right: 390px;
    top: 470px;
    padding: 12px;
    border-radius: 8px;
    background-color: var(--panel);
    align-items: center;
}

.respawn__title {
    font-size: 30px;
}

.respawn__by {
    font-size: 16px;
    color: var(--muted);
}

/* ---- Scoreboard ---- */

.board {
    position: absolute;
    left: 250px;
    right: 250px;
    top: 120px;
    padding: 14px 18px;
    border-radius: 10px;
    background-color: var(--panel);
}

.board--inline {
    position: relative;
    left: 0;
    right: 0;
    top: 0;
    margin-top: 8px;
    padding: 8px 14px;
    background-color: rgba(0, 0, 0, 0.25);
}

.board-title {
    font-size: 20px;
    letter-spacing: 2px;
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.board-row {
    flex-direction: row;
    height: 26px;
    align-items: center;
    padding: 0 6px;
    border-radius: 4px;
}

.board-row--head {
    color: var(--muted);
    font-size: 13px;
    letter-spacing: 2px;
}

.board-row--you {
    background-color: rgba(56, 217, 255, 0.18);
}

.board-swatch {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    margin-right: 8px;
    margin-top: 4px;
}

.board-place {
    width: 34px;
}

.board-name {
    flex-grow: 1;
}

.board-num {
    width: 70px;
    -unity-text-align: middle-right;
}

/* ---- Menus ---- */

.menu-dim {
    background-color: rgba(10, 4, 18, 0.62);
}

.menu-dim--light {
    background-color: rgba(10, 4, 18, 0.35);
}

.menu-panel {
    position: absolute;
    left: 360px;
    right: 360px;
    top: 50px;
    bottom: 40px;
    align-items: center;
}

.logo {
    align-items: center;
    margin-bottom: 4px;
}

.logo__title {
    font-size: 78px;
    height: 84px;
    color: var(--text);
    letter-spacing: 4px;
    text-shadow: 0 5px 0 rgba(164, 92, 255, 0.85);
}

.logo__tag {
    font-size: 16px;
    letter-spacing: 6px;
    color: var(--amber);
}

.menu-title {
    font-size: 46px;
    height: 54px;
    -unity-text-align: middle-center;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.6);
}

.menu-title--good {
    color: var(--good);
}

.menu-title--danger {
    color: var(--danger);
}

.menu-subtitle {
    font-size: 17px;
    color: var(--muted);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    white-space: normal;
}

.menu-body {
    width: 100%;
    margin-bottom: 10px;
}

.body-row {
    flex-direction: row;
    justify-content: space-between;
    height: 25px;
    padding: 0 10px;
}

.body-row__label {
    color: var(--muted);
    font-size: 16px;
}

.body-row__value {
    font-size: 16px;
}

.body-row--highlight .body-row__value {
    color: var(--gold);
}

.menu-items {
    width: 420px;
}

.menu-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 38px;
    margin-bottom: 4px;
    padding: 0 16px;
    border-radius: 6px;
    background-color: var(--panel-light);
    border-left-width: 4px;
    border-color: rgba(0, 0, 0, 0);
}

.menu-item--selected {
    background-color: rgba(56, 217, 255, 0.22);
    border-color: var(--cyan);
}

.menu-item__label {
    font-size: 19px;
}

.menu-item__value {
    font-size: 17px;
    color: var(--amber);
}

.menu-hint {
    position: absolute;
    bottom: 14px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 14px;
    color: var(--muted);
}

.credit {
    position: absolute;
    bottom: 14px;
    right: 18px;
    font-size: 12px;
    color: rgba(184, 168, 200, 0.7);
}
